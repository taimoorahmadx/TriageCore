# Environment Variables for TriageCore
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control!

# LLM Providers (Provide one)
OPENAI_API_KEY="sk-placeholder-key-do-not-commit"
ANTHROPIC_API_KEY="sk-placeholder-key-do-not-commit"

# GitHub App & Webhook Configuration
GITHUB_APP_ID="your_github_app_id"
GITHUB_WEBHOOK_SECRET="your_webhook_hmac_secret"
GITHUB_TOKEN="ghp_placeholder_token_for_opening_prs"

# Persistence
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/triage_core"

# Job Queue
REDIS_URL="redis://localhost:6379/0"
