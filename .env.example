# Environment Variables for TriageCore
# Copy this file to .env and fill in the real values:
#   cp .env.example .env
# NEVER commit .env to version control!

# ==========================================
# LLM Providers
# ==========================================
# Primary LLM for agents (Google AI Studio)
GEMINI_API_KEY="AIzaSy-placeholder-key-do-not-commit"

# Fallback LLM / POC Runner (Groq Cloud)
GROQ_API_KEY="gsk_placeholder_key_for_groq_api"
GROQ_CURL_TIMEOUT_SECONDS=10

# ==========================================
# GitHub CI Integration & Webhooks
# ==========================================
GITHUB_APP_ID="your_github_app_id"
GITHUB_WEBHOOK_SECRET="your_webhook_hmac_secret"
GITHUB_TOKEN="ghp_placeholder_token_for_opening_prs"

# ==========================================
# Persistence & Database (Docker Compose)
# ==========================================
DATABASE_URL="postgresql://triage_user:triage_password@localhost:5432/triage_db"

# ==========================================
# Job Queue (Redis)
# ==========================================
REDIS_URL="redis://localhost:6379/0"
