# Environment Variables for TriageCore
# Copy this file to .env and fill in the real values:
#   cp .env.example .env
# NEVER commit .env to version control!

# Groq Cloud
GROQ_API_KEY=
GROQ_CURL_TIMEOUT_SECONDS=10

# GitHub webhook validation
GITHUB_WEBHOOK_SECRET=

# Decision store
TRIAGECORE_DB_PATH=data/triagecore.sqlite3
TRIAGECORE_API_TOKEN=

# Optional: only for scripts/collect_ci_corpus.py; raises the API rate limit.
# GITHUB_TOKEN=
